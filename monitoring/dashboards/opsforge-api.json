{
  "uid": "opsforge-api-overview",
  "title": "OpsForge API Overview",
  "description": "API metrics collected from the local Kubernetes cluster.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["opsforge", "observability"],
  "timezone": "Europe/Zurich",
  "refresh": "15s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Metrics targets UP",
      "description": "Pods whose metrics endpoint can be scraped. This lab expects two targets.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{namespace=\"default\",service=\"opsforge-api\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 1},
              {"color": "green", "value": 2}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 6, "y": 0, "w": 18, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(opsforge_http_requests_total{namespace=\"default\",service=\"opsforge-api\"}[$__rate_interval]))",
          "legendFormat": "Requests",
          "interval": "15s",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps", "min": 0},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "HTTP 5xx per second",
      "description": "Zero is shown only when a request-rate series is available.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(opsforge_http_requests_total{namespace=\"default\",service=\"opsforge-api\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(opsforge_http_requests_total{namespace=\"default\",service=\"opsforge-api\"}[$__rate_interval])))",
          "legendFormat": "Server errors",
          "interval": "15s",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps", "min": 0},
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Mean API processing time",
      "description": "Server processing time until response headers, in milliseconds. Undefined without request observations.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum(rate(opsforge_http_request_duration_seconds_sum{namespace=\"default\",service=\"opsforge-api\"}[$__rate_interval])) / sum(rate(opsforge_http_request_duration_seconds_count{namespace=\"default\",service=\"opsforge-api\"}[$__rate_interval]))",
          "legendFormat": "Mean processing time",
          "interval": "15s",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms", "min": 0, "decimals": 2},
        "overrides": []
      }
    }
  ]
}